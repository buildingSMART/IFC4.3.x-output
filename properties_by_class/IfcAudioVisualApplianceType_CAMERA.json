          "enumName": "PEnum_AudioVisualCameraType",
          "enumValues": [
            "AUDIOVIDEO",
            "PHOTO",
            "VIDEO",
            "OTHER",
            "NOTKNOWN",
            "UNSET"
          ]
        },
        {
