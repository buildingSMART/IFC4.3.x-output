msgstr "Tahrik Düzeneği Uygulaması"

msgid "ActuatorApplication_DEFINITION"
msgstr "Tahrik düzeneğinin kullanım alanını gösterir."

msgid "ActuatorApplication_DAMPERACTUATOR"
msgstr "Sönümleyici Tahrik Düzeneği"

msgid "ActuatorApplication_ENTRYEXITDEVICE"
