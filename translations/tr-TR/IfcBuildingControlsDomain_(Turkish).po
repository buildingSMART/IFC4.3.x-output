msgid "ActuatorStatus"
msgstr "Tahrik Düzeneği Durumu"

msgid "ActuatorStatus_DEFINITION"
msgstr "Eleman [[Status]] durumu, ağırlıklı olarak renovasyon veya tadilat projelerinde kullanılır. Durum, 'Yeni' - yeni bir ilave olarak tasarlanmıştır, 'Mevcut' - mevcut olup korunacaktır, 'Yıkılacak' - mevcut olup yıkılacaktır, 'Geçici' - yalnızca geçici olarak var olacaktır (geçici destek yapısı gibi) olarak atanabilir."

msgid "ActuatorStatus_DEMOLISH"
msgstr "'Yıkılacak' - eleman mevcut olup yıkılacaktır"

msgid "ActuatorStatus_EXISTING"
msgstr "'Mevcut' - eleman mevcut olup korunacaktır"

msgid "ActuatorStatus_NEW"
msgstr "Durum \"Yeni\" olarak atanabilir - eleman yeni bir ilave olarak tasarlanmıştır"

msgid "ActuatorStatus_NOTKNOWN"
msgstr "Bilinmiyor"

msgid "ActuatorStatus_OTHER"
msgstr "Diğer"

msgid "ActuatorStatus_TEMPORARY"
msgstr "'Geçici' - eleman yalnızca geçici olarak var olacaktır (örnek olarak geçici bir destek yapısı gibi)"

msgid "ActuatorStatus_UNSET"
msgstr "Belirlenmemiş"

msgid "FailPosition"
msgstr "Arıza Konumu"

msgid "FailPosition_DEFINITION"
msgstr "Tahrik düzeneğinin gerekli güvenli durumunu belirtir."

msgid "FailPosition_FAILCLOSED"
