msgid "MoistureContent"
msgstr "Nem İçeriği"

msgid "MoistureContent_DEFINITION"
msgstr "Ahşabın fırında kurutulmuş ağırlığına göre toplam nem miktarı."

msgid "Plies"
msgstr "Tabakalar"

msgid "Plies_DEFINITION"
