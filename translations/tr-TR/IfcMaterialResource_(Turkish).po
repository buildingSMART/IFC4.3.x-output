msgid "Species"
msgstr "Türler"

msgid "Species_DEFINITION"
msgstr "Masif ahşap veya lamine edilmiş ahşap ürününün ağaç türü."

msgid "StrengthGrade"
msgstr "Dayanım Sınıfı"

msgid "StrengthGrade_DEFINITION"
msgstr "Mekanik dayanım ve rijitlik ile ilgili sınıf."

msgid "ThicknessSwelling"
msgstr "Kalınlık Şişmesi"

msgid "ThicknessSwelling_DEFINITION"
