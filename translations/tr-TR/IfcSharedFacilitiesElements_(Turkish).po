msgid "IncorporationDate_DEFINITION"
msgstr "Bir varlığın projeye dâhil edildiği, kurulduğu, monte edildiği veya tamamlandığı tarih."

msgid "IfcFurniture"
msgstr "Mobilya"

msgid "IfcFurniture_DEFINITION"
msgstr "Mobilya, yapının yapısına kalıcı olarak bağlı veya bağımsız olabilen masa, sandalye, dolap gibi donanımları tanımlar."

msgid "Pset_FurnitureTypeCommon"
msgstr "Özellik Seti: Mobilya Ortak Tipi"

msgid "Pset_FurnitureTypeCommon_DEFINITION"
msgstr "Tüm mobilya türleri için ortak özellikler; örn. sandalye, masa, dosya dolabı."

msgid "IsBuiltIn"
msgstr "Gömülü / Yerleşik mi?"

msgid "IsBuiltIn_DEFINITION"
msgstr "Mobilyanın gömülü (yerleşik) olup, bina/tesise fiziksel olarak bağlı olduğunu (=TRUE) ya da serbest ve taşınabilir olduğunu (=FALSE) belirtir."

msgid "MainColour"
msgstr "Ana Renk"

msgid "MainColour_DEFINITION"
msgstr "Bu tür mobilyaların ana rengi."

msgid "Style"
msgstr "Tarz"

msgid "Style_DEFINITION"
msgstr "Mobilya stilinin [[Description]]ı."

