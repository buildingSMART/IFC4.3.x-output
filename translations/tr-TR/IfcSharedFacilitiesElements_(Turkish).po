msgid "IfcAsset"
msgstr "Varlık"

msgid "IfcAsset_DEFINITION"
msgstr "Bir varlık, finansal bir değere sahip olan veya tek bir birim olarak işletilebilen, tekil olarak tanımlanabilir elemanların bir araya getirilmiş halidir."

msgid "Pset_Asset"
msgstr "Özellik Seti: Varlık"

msgid "Pset_Asset_DEFINITION"
msgstr "Bir varlık, finansal değeri olan ve bakım işlemlerinin kaydedildiği, benzersiz bir şekilde tanımlanabilir bir elementtir."

msgid "AssetAccountingType"
msgstr "Varlık Muhasebe Tipi"

msgid "AssetAccountingType_DEFINITION"
msgstr "Gerekli tipin seçilebileceği, önceden tanımlı muhasebe sınıflarını belirtir."

msgid "AssetAccountingType_FIXED"
msgstr "Duran"

msgid "AssetAccountingType_NONFIXED"
msgstr "Dönen"

