msgid "AssetInsuranceType_DEFINITION"
msgstr "Gerekli tipin seçilebileceği, önceden tanımlı sigorta türlerini belirtir."

msgid "AssetInsuranceType_NOTKNOWN"
msgstr "Bilinmiyor"

msgid "AssetInsuranceType_OTHER"
msgstr "Diğer"

msgid "AssetInsuranceType_PERSONAL"
msgstr "Kişisel"

msgid "AssetInsuranceType_REAL"
msgstr "Maddi"

msgid "AssetInsuranceType_UNSET"
msgstr "Belirlenmemiş"

msgid "AssetStatus"
msgstr "Varlık Durumu"

msgid "AssetStatus_DEFINITION"
msgstr "Varlığın [[Current]] yaşam döngüsündeki durum veya aşaması."

msgid "AssetTaxType"
msgstr "Varlık Vergi Tipi"

msgid "AssetTaxType_DEFINITION"
msgstr "Gerekli tipin seçilebileceği, önceden tanımlı vergi gruplarını belirtir."

