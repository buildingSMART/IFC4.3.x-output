msgstr "Özellik Seti: Sistem Mobilya Elemanı Ortak Tipi"

msgid "Pset_SystemFurnitureElementTypeCommon_DEFINITION"
msgstr "Tüm sistem (modüler) mobilya eleman tipleri için ortak özellikler; örn. dikey paneller, çalışma yüzeyleri, depolama."

msgid "Finishing"
msgstr "Yüzey Kaplama / Bitirme"

msgid "Finishing_DEFINITION"
msgstr "Bu tür sistem mobilya elemanlarına uygulanan bitişler, örn. ceviz, kumaş."

msgid "GroupCode"
msgstr "Grup Kodu"

msgid "GroupCode_DEFINITION"
msgstr "Örn. paneller, çalışma yüzeyleri, depolama vb."

msgid "IsUsed"
msgstr "Kullanımda mı"

msgid "IsUsed_DEFINITION"
msgstr "Elemanın bir çalışma istasyonunda kullanılıp (=TRUE) kullanılmadığını (=FALSE )belirtir."

