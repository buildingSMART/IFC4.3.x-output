msgid "IfcExternallyDefinedHatchStyle"
msgstr "Harici Bir Kaynaktan Tanımlanmış Tarama Stili"

msgid "IfcExternallyDefinedSurfaceStyle"
msgstr "Harici Bir Kaynaktan Tanımlanmış Yüzey Stili"

msgid "IfcExternallyDefinedSurfaceStyle_DEFINITION"
msgstr "[[IfcExternallyDefinedSurfaceStyle]], bir yüzey stilinin, görselleştirme bilgileri için bir malzeme kütüphanesi gibi harici bir kaynağa başvurularak tanımlanmasıdır."

msgid "IfcExternallyDefinedTextFont"
msgstr "Harici Bir Kaynaktan Tanımlanmış Yazı Tipi"

msgid "IfcTextureCoordinateIndices"
msgstr "Doku Koordinat İndeksleri"

msgid "IfcTextureCoordinateIndices_DEFINITION"
msgstr "[[IfcTextureCoordinateIndices]], bir IfcIndexedPolygonalFace için doku koordinatlarını sağlar. [[TexCoordIndex]], TexCoordsOf.CoordIndex içinde IfcCartesianPointList3D'ye işaret eden bir dizi indeks tutan doku koordinatları için IfcTextureVertexList'e işaret eden indekslerin bir listesini içerir."

msgid "TexCoordIndex"
msgstr "Doku Koordinat İndeksi"

msgid "TexCoordIndex_DEFINITION"
msgstr "IfcTextureVertexList içine işaret eden indeksler listesi; kalıtılmış TexCoords özniteliği tarafından referans verilir."

msgid "IfcTextureCoordinateIndicesWithVoids"
msgstr "Boşluklu Doku Koordinatı İndeksleri"

msgid "IfcTextureCoordinateIndicesWithVoids_DEFINITION"
msgstr "[[IfcTextureCoordinateIndicesWithVoids]], [[IfcTextureCoordinateIndices]]’in bir alt türüdür ve iç döngülere (voids / deliklere) sahip çokgen yüzeylere doku koordinatlarını sağlamak için kullanılır."

msgid "InnerTexCoordIndices"
msgstr "İç Doku Koordinat İndeksleri"

