msgstr "Yüzeyin düşey sapmalarının ölçüsü."

msgid "ShadingDeviceType"
msgstr "Gölgeleme Elemanı Türü"

msgid "ShadingDeviceType_DEFINITION"
msgstr "Gölgeleme elemanı türünü belirtir."

